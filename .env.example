# 복사해서 .env 로 만들고 값을 채우세요. (.env 는 git 에 올리지 않습니다. 자세한 설명은 README "환경 변수")

# --- Amazon Bedrock (필수: LLM 과 Titan 임베딩) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# --- 국립중앙의료원 응급의료정보 조회 서비스 (공공데이터포털, 응급실 목록 안내용) ---
GOV_DATA_API_ENDPOINT=
GOV_DATA_API_KEY=

# --- 선택 (비우면 기본값) ---
# BEDROCK_MODELS=
# BEDROCK_FAST_MODELS=
# BEDROCK_MAX_ATTEMPTS=6
# BEDROCK_READ_TIMEOUT=60
# MODEL_DAILY_COOLDOWN_S=300
# MODEL_THROTTLE_COOLDOWN_S=60
# DISABLE_FALLBACK=0     # 1 이면 폴백 없이 한 모델만 (평가 재현용)
# WARMUP=1               # 0 이면 서버 시작 시 미리 데우기 끔
# MOCK_MODE=0            # 1 은 UI 개발용 고정 응답. 운영에서는 0
# MEMORY_DB=data/memory/memory.sqlite
